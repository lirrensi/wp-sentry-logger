{
    "name": "lirrensi/error-logger-for-sentry",
    "description": "WordPress error monitoring plugin for any Sentry-compatible backend (official sentry/sentry SDK)",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "lirrensi",
            "homepage": "https://github.com/lirrensi"
        }
    ],
    "homepage": "https://github.com/lirrensi/wp-sentry-logger",
    "support": {
        "source": "https://github.com/lirrensi/wp-sentry-logger",
        "issues": "https://github.com/lirrensi/wp-sentry-logger/issues"
    },
    "require": {
        "php": ">=8.2",
        "sentry/sentry": "^4.14"
    },
    "config": {
        "platform": {
            "php": "8.3.6"
        }
    },
    "autoload": {
        "psr-4": {
            "WPSentryLogger\\": "src/"
        }
    }
}
